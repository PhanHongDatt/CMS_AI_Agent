        "evidence_completeness": {
          "maximum": 1.0,
          "minimum": 0.0,
          "title": "Evidence Completeness",
          "type": "number"
        },
        "evidence_consistency": {
          "maximum": 1.0,
          "minimum": 0.0,
          "title": "Evidence Consistency",
          "type": "number"
        },
        "rca_agreement": {
          "maximum": 1.0,
          "minimum": 0.0,
          "title": "Rca Agreement",
          "type": "number"
        },
        "model_output_quality": {
          "maximum": 1.0,
          "minimum": 0.0,
          "title": "Model Output Quality",
          "type": "number"
        },
        "historical_success": {

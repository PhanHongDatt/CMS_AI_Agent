          "type": "number"
        },
        "evidence_completeness": {
          "default": 0.2,
          "title": "Evidence Completeness",
          "type": "number"
        },
        "evidence_consistency": {
          "default": 0.2,
          "title": "Evidence Consistency",
          "type": "number"

# Copy this file to .env and fill in real values. NEVER commit .env.

# PostgreSQL
DATABASE_URL=postgresql+asyncpg://user:password@localhost:5432/agent_platform

# Redis
REDIS_URL=redis://localhost:6379/0

# LLM Gateway
LLM_GATEWAY_URL=http://localhost:8001
LLM_GATEWAY_API_KEY=change-me

# Application
APP_ENV=development          # development | staging | production
LOG_LEVEL=INFO
LOG_FORMAT=json              # json | console

# Cost limits (USD)
COST_LIMIT_PER_INCIDENT=1.00
COST_LIMIT_DAILY=20.00

# Approval timeout (seconds)
APPROVAL_TIMEOUT_SECONDS=300

# API base URL (used by bot to call the API)
API_BASE_URL=http://api:8000   # use http://localhost:8000 for local dev

# Telegram Bot
TELEGRAM_BOT_TOKEN=your-bot-token-here
TELEGRAM_CHAT_ID=your-chat-id-here          # chat/group ID that receives notifications
TELEGRAM_ALLOWED_USERS=username1,username2  # comma-separated, empty = allow all

# LLM Providers (optional — uses mock if not set)
ANTHROPIC_API_KEY=
GEMINI_API_KEY=

# Webhook security (optional)
WEBHOOK_SECRET=
